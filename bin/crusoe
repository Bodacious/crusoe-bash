#!/usr/bin/env bash
set -euo pipefail
DEBUG=false
entries_dir="/Users/gavin/.crusoe/entries"

CRUSOE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly CRUSOE_ROOT

load-util() {
  local util_name="${1}"
  source "$CRUSOE_ROOT/lib/$util_name.bash"
}

load-command() {
  local command_name="${1}"
  source "$CRUSOE_ROOT/lib/crusoe/commands/$command_name.bash"
}

load-util "logging"

main() {
  debug 'Main'
  local command="${1:-journal}"
  case "$command" in
    journal)
      shift || true
      crusoe::journal "$@"
      ;;
    read)
      shift || true
      crusoe::read "$@"
      ;;
    -h|--help)
      load-command "help"
      help
      ;;
    *)
      echo "Unknown sub-command $1" >&2
      usage
      return 2
      ;;
  esac
};


crusoe::_entry_file_path() {
  local entry_date=""
  local entry_month=""

  entry_date="$(gdate --date "${1:-today}" +'%F')" || return
  entry_month="$(gdate --date "$entry_date" +'%Y/%m')" || return

  printf '%s/%s/%s.md' "$entries_dir" "$entry_month" "$entry_date"
}

crusoe::journal(){
  debug "Crusoe journal"

  local entry_date=""
  entry_date=$(date +%F) # default if not overwritten
  local entry_file_path=""
  while [[  $# -gt 0 ]]; do
    case "$1" in
      --debug)
        DEBUG=true
        shift
        ;;
      --today)
        entry_date=$(date +%F)
        shift
        ;;
      --date=*)
        entry_date="${1#--date=}"
        entry_date=$(gdate --date "$entry_date" +%F)
        shift
        ;;
      *)
        echo "Unrecogised option $1"
        shift
        return 2
        ;;
    esac
  done
  debug "Writing entry for date $entry_date"

  entry_file_path=$(crusoe::_entry_file_path "$entry_date")

  if [ -f "$entry_file_path" ]; then
    debug "File exists $entry_file_path"
  else
    debug "File does not exists $entry_file_path"
    mkdir -p "$(dirname "$entry_file_path")"
    touch "$entry_file_path"
    debug "Created file $entry_file_path"
  fi
  debug "${EDITOR:-nano}" "$entry_file_path"
  "$EDITOR" "$entry_file_path"
  crusoe::git::commit_changes "$entry_file_path" "$entry_date"
}

crusoe::read() {
  debug "Crusoe read"

  local entry_date=""
  entry_date=$(date +%F) # default if not overwritten
  local entry_file_path=""
  while [[  $# -gt 0 ]]; do
    case "$1" in
      --debug)
        DEBUG=true
        shift
        ;;
      --today)
        entry_date=$(date +%F)
        shift
        ;;
      --date=*)
        entry_date="${1#--date=}"
        entry_date=$(gdate --date "$entry_date" +%F)
        shift
        ;;
      *)
        echo "Unrecogised option $1"
        shift
        return 2
        ;;
    esac
  done
  debug "entry_date: $entry_date"

  entry_file_path=$(crusoe::_entry_file_path "$entry_date")
  if [[ -f "$entry_file_path" ]];then
    cat "$entry_file_path"
  else
    echo "Crusoe: No entry for $entry_date"
  fi
  exit 0
}

crusoe::git::commit_changes() {
  local entry_file_path=$1
  local entry_date=$2

  debug "Git dir: $entries_dir"
  git -C $entries_dir add "$entry_file_path"
  git -C $entries_dir commit -m "Update journal for $entry_date"
  git -C $entries_dir push origin main
}

main "$@";
